---
/**
 * One key point: the idea in a paragraph, then where to read it properly.
 *
 * A reading is a single line: the place to read, linked. No source title, no
 * byline, no explanation of what the link contains. Because the line is all the
 * reader gets, an `at` value has to name its own source — "Anthropic docs
 * § …", "mini-swe-agent · default.py …" — rather than only the section, which
 * would leave three anonymous links in a box.
 */
import { resolvePointer, type ReadingPointer } from '../lib/reading';
import { inlineCode } from '../lib/inline-code';

interface Props {
  n: number;
  heading: string;
  summary: string;
  reading: ReadingPointer[];
}

const { n, heading, summary, reading } = Astro.props;
const pointers = reading.map(resolvePointer);
---

<section class="point" aria-labelledby={`point-${n}`}>
  <h2 id={`point-${n}`}>
    <span class="point-n" aria-hidden="true">{String(n).padStart(2, '0')}</span>
    {heading}
  </h2>

  <p class="point-summary" set:html={inlineCode(summary)} />

  <h3 class="reading-heading">Read</h3>
  <ol class="reading">
    {
      pointers.map((p) => (
        <li>
          <a href={p.url} rel="noopener">
            {p.at}
          </a>
        </li>
      ))
    }
  </ol>
</section>
