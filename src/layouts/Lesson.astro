---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Base from './Base.astro';
import SourceList from '../components/SourceList.astro';
import KeyPoint from '../components/KeyPoint.astro';
import TraceViewer from '../components/TraceViewer';
import { COMPONENTS } from '../data/architecture';
import { STATUS_LABEL } from '../data/progress';
import { href } from '../lib/href';
import { inlineCode } from '../lib/inline-code';
import { lessonMinutes, hasNotes } from '../lib/reading-time.mjs';

interface Props {
  lesson: CollectionEntry<'lessons'>;
  prev: CollectionEntry<'lessons'> | null;
  next: CollectionEntry<'lessons'> | null;
}

const { lesson, prev, next } = Astro.props;
const { n, title, part, component, status, takeaway, intro, points, extraReading, outline, exercise, build } =
  lesson.data;
const comp = COMPONENTS.find((c) => c.id === component)!;

// Base for "see the code" links into the public repo.
const GITHUB = 'https://github.com/mrm1001/tiny-agents/tree/main/';

// Resolve the recorded run the Build viewer replays. A missing trace file only
// WARNS at the collection loader and getEntry returns undefined, which would make
// the viewer silently vanish on a green build — so throw instead.
let trace: CollectionEntry<'traces'>['data'] | null = null;
if (exercise?.trace) {
  const entry = await getEntry('traces', exercise.trace);
  if (!entry) {
    throw new Error(
      `Lesson ${n}: exercise.trace "${exercise.trace}" does not resolve to a file in ` +
        `src/content/traces/. Record it (see the Build instructions) or fix the id.`,
    );
  }
  trace = entry.data;
}

// The same function `check:lessons` uses, so the page and the budget check can
// never disagree. Outlines and stubs have no read to time.
const minutes = outline || status === 'locked' ? null : lessonMinutes({ intro, points });

// Everything below a lesson's frontmatter is Maria's hand-written notes, not
// lesson prose, so it renders below the points under its own heading and is left
// out of the reading time. When the notes are missing the panel must not render
// at all — see `hasNotes`, which also keeps the placeholder comment every lesson
// ships with out of the built page.
const showNotes = hasNotes(lesson.body);

---

<Base title={`${n}. ${title} — Tiny Agents`} description={takeaway} section="learn">
  <article class="lesson">
    <p class="lesson-meta">
      <a href={href('/lessons/')}>Part {part}</a>
      <span aria-hidden="true">·</span>
      <span>Lesson {String(n).padStart(2, '0')} of 36</span>
      <span aria-hidden="true">·</span>
      <a href={href('/#curriculum')}>{comp.label}</a>
      {
        minutes && (
          <>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </>
        )
      }
      <span class={`chip st-${status}`}>{STATUS_LABEL[status]}</span>
    </p>

    <h1>{title}</h1>

    <div class="takeaway-callout">
      <span class="k">What you should understand afterwards</span>
      <p set:html={inlineCode(takeaway)} />
    </div>

    {
      outline && (
        <p class="outline-note">
          <strong>This is an outline, not the finished lesson.</strong> It lists what the lesson will
          cover and which sources back each point, so the shape can be reviewed before the prose is
          written.
        </p>
      )
    }

    {intro && <p class="lesson-intro">{intro}</p>}

    {points.map((point, i) => <KeyPoint n={i + 1} {...point} />)}

    {
      showNotes && (
        <section class="notes" aria-labelledby="h-notes">
          <h2 id="h-notes">My notes</h2>
          <div class="lesson-body">
            <slot />
          </div>
        </section>
      )
    }

    {
      build && (
        <section class="build" aria-labelledby="h-build">
          <h2 id="h-build">Build — write the agent</h2>
          <p>{build.goal}</p>
          {build.provided.length > 0 && (
            <>
              <h3>Provided for you — don&rsquo;t edit</h3>
              <ul>{build.provided.map((x) => <li set:html={inlineCode(x)} />)}</ul>
            </>
          )}
          {build.yourJob.length > 0 && (
            <>
              <h3>Your job</h3>
              <ul>{build.yourJob.map((x) => <li set:html={inlineCode(x)} />)}</ul>
            </>
          )}
          <p>
            Run it: <code>{build.run}</code>
          </p>
          <p class="build-success" set:html={inlineCode(build.success)} />
          <p>
            <a href={GITHUB + build.repoPath} rel="noopener">See the code on GitHub &rarr;</a>
          </p>
          {trace && <TraceViewer trace={trace} client:load />}
        </section>
      )
    }

    {
      exercise && !build && (
        <section class="exercise-callout">
          <span class="k">Exercise</span>
          <p>
            Run it yourself — the code lives in <code>{exercise.dir}</code> in this repository.
          </p>
          <pre><code>{exercise.command}</code></pre>
        </section>
      )
    }

    {extraReading.length > 0 && <SourceList heading="Extra reading" refs={extraReading} />}

    {
      status === 'locked' && (
        <p class="stub-note">
          This lesson hasn&rsquo;t been written yet — <strong>{comp.label}</strong> is still locked
          on the <a href={href('/')}>architecture diagram</a>. The takeaway above is the outline it
          will be written against.
        </p>
      )
    }

    <nav class="prevnext" aria-label="Lesson navigation">
      {
        prev ? (
          <a href={href(`/lessons/${prev.id}/`)}>
            <span class="dir">← Previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="nx" href={href(`/lessons/${next.id}/`)}>
            <span class="dir">Next →</span>
            {next.data.title}
          </a>
        ) : (
          <span class="nx" />
        )
      }
    </nav>
  </article>
</Base>
